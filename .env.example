# ==== Server ====
PORT=7000
DOMAIN=http://localhost:7000
SESSION_SECRET=change_this_to_a_long_random_string

# ==== Admin login (used for /admin panel only) ====
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change_this_password

# ==== Email (SMTP) - used to send OTP / verification / reset links ====
EMAIL_HOST=your.smtp.host
EMAIL_USER=no-reply@yourdomain.com
EMAIL_PASS=your_smtp_password
SMTP_PORT=465

# ==== AWS Bedrock (Claude models) - primary AI provider ====
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
# Optional second AWS key - tried automatically if the first AWS key fails
AWS_BEARER_TOKEN_BEDROCK_2=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ==== Backup AI providers ====
# If every AWS Bedrock key above fails (expired, no access, outage, etc),
# ZyreX automatically retries the same chat message using these instead,
# so the user never sees an error. Tried in this order: Gemini, then OpenAI.

# Google Gemini - FREE, no credit card required.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI - optional, requires billing/credits on your OpenAI account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
